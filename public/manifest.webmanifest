{
  "name": "Northcroft QS Team",
  "short_name": "QS Team",
  "description": "Projects, tasks, announcements and attendance for the Northcroft QS Team.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b1a33",
  "theme_color": "#0b1a33",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png?v=onyx",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png?v=onyx",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png?v=onyx",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/*",
            "audio/*",
            "text/csv",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".pdf",
            ".csv",
            ".xls",
            ".xlsx",
            ".doc",
            ".docx",
            ".jpg",
            ".jpeg",
            ".png",
            ".heic",
            ".m4a",
            ".mp3",
            ".ogg",
            ".opus"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Check in",
      "url": "/attendance",
      "icons": [
        {
          "src": "/icons/shortcut-checkin.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New task",
      "url": "/my-tasks?new=1",
      "icons": [
        {
          "src": "/icons/shortcut-newtask.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Daily update",
      "url": "/updates",
      "icons": [
        {
          "src": "/icons/shortcut-update.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Time report",
      "url": "/time",
      "icons": [
        {
          "src": "/icons/shortcut-time.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My tasks",
      "url": "/my-tasks",
      "icons": [
        {
          "src": "/icons/shortcut-tasks.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
